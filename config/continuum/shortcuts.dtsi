// shortcut select os
#ifdef MAC_OS
// homerow mods
  #define M_IDX LGUI
  #define M_PNK LCTRL
// clipboard shortcut
  #define C_RDO LG(LS(Z))
  #define C_PST LG(V)
  #define C_CPY LG(C)
  #define C_CUT LG(X)
  #define C_UND LG(Z)
  #define C_ALL LG(A)
// Desktop and tab navigation shortcuts
  #define LANG_CHANGE LC(LG(SPACE))
  #define SCREENSHOT LC(LG(LS(N4)))
  #define LOCK  &kp LC(LG(Q))
  #define W_CLS LG(Q)
  #define T_CLS LG(W)
  #define T_RHT LC(TAB)
  #define T_LFT LC(LS(TAB))
  #define W_RHT LG(TAB)
  #define W_LFT LG(LS(TAB))
  #define D_PRV LG(LC(LEFT))
  #define D_NXT LG(LC(RIGHT))

  
  // Hold → Cmd + Left/Right = start/end of line.
  // If Cmd is already held, consume it to avoid accidental modifier stacking.
  MASK_MODS(masked_home, (MOD_LGUI), &kp LEFT)
  MASK_MODS(masked_end,  (MOD_LGUI), &kp RIGHT)

  ZMK_HOLD_TAP(mt_home, bindings = <&masked_home>, <&kp>; MT_CORE)
  ZMK_HOLD_TAP(mt_end,  bindings = <&masked_end>,  <&kp>; MT_CORE)

  // Hold → Cmd + Up/Down = start/end of document.
  // If Cmd is already held, consume it to avoid accidental modifier stacking.

  MASK_MODS(masked_doc_up, (MOD_LGUI), &kp LG(UP))
  MASK_MODS(masked_doc_down, (MOD_LGUI), &kp LG(DOWN))

  ZMK_HOLD_TAP(mt_doc_up, bindings = <&masked_doc_up>, <&kp>; MT_CORE)
  ZMK_HOLD_TAP(mt_doc_down, bindings = <&masked_doc_down>, <&kp>; MT_CORE)

  #define NAV_LEFT &mt_home 0 LEFT   // Tap: left  | Long-tap: start of line.
  #define NAV_RIGHT &mt_end 0 RIGHT  // Tap: right | Long-tap: end of line.
  #define NAV_UP &mt_doc_up 0 UP     // Tap: up    | Long-tap: start of doc.
  #define NAV_DOWN &mt_doc_down 0 DOWN   // Tap: down  | Long-tap: end of doc.

  #define SPACE_FULL &kp LC(LG(F))

  // window and fit
  #define WIN_LEFT    &kp LC(LA(LG(LEFT)))
  #define WIN_RIGHT   &kp LC(LA(LG(RIGHT)))
  #define FIT_LEFT    &kp LC(LA(LEFT))
  #define FIT_RIGHT   &kp LC(LA(RIGHT))
  #define SPACE_LEFT  &kp LC(LEFT)
  #define SPACE_RIGHT &kp LC(RIGHT)
  #define SP_LEFT     &kp LC(LEFT)
  #define SP_RIGHT    &kp LC(RIGHT)
#else
// homerow mods
  #define M_IDX LCTRL
  #define M_PNK LGUI
// clipboard shortcut
  #define C_RDO LC(Y)
  #define C_PST LC(V)
  #define C_CPY LC(C)
  #define C_CUT LC(X)
  #define C_UND LC(Z)
  #define C_ALL LC(A)
// Desktop and tab navigation
  #define LANG_CHANGE LANG1
  #define SCREENSHOT LG(LS(S))
  #define LOCK  &kp LG(L)
  #define W_CLS LA(F4)
  #define T_CLS LC(F4)
  #define T_RHT LC(TAB)
  #define T_LFT LC(LS(TAB))
  #define W_RHT LA(TAB)
  #define W_LFT LA(LS(TAB))
  #define D_PRV LG(LC(LEFT))
  #define D_NXT LG(LC(RIGHT))

  // Hold → Home/End = start/end of line.
  // If Ctrl is already held, consume it to avoid accidental Ctrl+Home/End.
  MASK_MODS(masked_left, (MOD_LCTL), &kp HOME)
  MASK_MODS(masked_right,  (MOD_LCTL), &kp END)

  ZMK_HOLD_TAP(mt_left, bindings = <&masked_left>, <&kp>; MT_CORE)
  ZMK_HOLD_TAP(mt_right,  bindings = <&masked_right>,  <&kp>; MT_CORE)

  // Hold → Ctrl + Home/End = start/end of document.
  // If Ctrl is already held, consume it to avoid accidental modifier stacking.

  MASK_MODS(masked_doc_home, (MOD_LCTL), &kp LC(HOME))
  MASK_MODS(masked_doc_end, (MOD_LCTL), &kp LC(END))

  ZMK_HOLD_TAP(mt_doc_home, bindings = <&masked_doc_home>, <&kp>; MT_CORE)
  ZMK_HOLD_TAP(mt_doc_end, bindings = <&masked_doc_end>, <&kp>; MT_CORE)

  #define NAV_LEFT  &mt_left 0       LEFT   // Tap: left  | Long-tap: start of line.
  #define NAV_RIGHT &mt_right 0       RIGHT  // Tap: right | Long-tap: end of line.
  #define NAV_UP    &mt_doc_home 0     UP     // Tap: up    | Long-tap: start of doc.
  #define NAV_DOWN  &mt_doc_end 0      DOWN   // Tap: down  | Long-tap: end of doc.

  #define SPACE_FULL  &kp LG(UP)

  // window and fit
  #define WIN_LEFT    &kp LG(LEFT)       // Win + Left
  #define WIN_RIGHT   &kp LG(RIGHT)      // Win + Right
  #define SPACE_LEFT  &kp LC(LG(LEFT))   // Ctrl + Win + Left
  #define SPACE_RIGHT &kp LC(LG(RIGHT))  // Ctrl + Win + Right
  #define SP_LEFT     &kp LC(LG(LEFT))   // Ctrl + Win + Left
  #define SP_RIGHT    &kp LC(LG(RIGHT))  // Ctrl + Win + Right
  #define FIT_LEFT    &kp LS(LG(LEFT))   // Shift + Win + Left
  #define FIT_RIGHT   &kp LS(LG(RIGHT))  // Shift + Win + Right
#endif
// Desktop management shortcuts
#define PIN_WIN   &kp LG(LC(LS(Q)))       // Pin window across desktops.
#define PIN_APP   &kp LG(LC(LS(A)))       // Pin application across desktops.
#define DSK_MGR   &kp LA(GRAVE)           // Desktop manager.
