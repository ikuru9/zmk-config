// shortcut select os
#ifdef MAC_OS
// homerow mods
  #define OL_IDX LGUI
  #define OL_PNK LCTRL
  #define OR_IDX RGUI
  #define OR_PNK RCTRL
// clipboard shortcut
  #define C_RDO LG(LS(Z))
  #define C_PST LG(V)
  #define C_CPY LG(C)
  #define C_CUT LG(X)
  #define C_UND LG(Z)
  #define C_ALL LG(A)
// Desktop and tab navigation shortcuts
  #define LANG_CHANGE LC(LG(SPACE))
  #define SCREENSHOT LC(LG(LS(N4)))
  #define LOCK  &kp LC(LG(Q))
  #define W_CLS LG(Q)
  #define T_CLS LG(W)
  #define T_RHT LC(TAB)
  #define T_LFT LC(LS(TAB))
  #define W_RHT LG(TAB)
  #define W_LFT LG(LS(TAB))
  #define D_PRV LG(LC(LEFT))
  #define D_NXT LG(LC(RIGHT))

// Tap: Left/Right | Double-tap: Cmd + Left/Right = start/end of line.
  MASK_MODS(masked_home, (MOD_LGUI), &kp LEFT)
  MASK_MODS(masked_end,  (MOD_LGUI), &kp RIGHT)

  ZMK_TAP_DANCE(td_home, bindings = <&kp LEFT>, <&masked_home>;
                tapping-term-ms = <220>;)
  ZMK_TAP_DANCE(td_end, bindings = <&kp RIGHT>, <&masked_end>;
                tapping-term-ms = <220>;)

// Tap: Up/Down | Double-tap: Cmd + Up/Down = start/end of document.
  MASK_MODS(masked_doc_up, (MOD_LGUI), &kp LG(UP))
  MASK_MODS(masked_doc_down, (MOD_LGUI), &kp LG(DOWN))

  ZMK_TAP_DANCE(td_doc_up, bindings = <&kp UP>, <&masked_doc_up>;
                tapping-term-ms = <220>;)
  ZMK_TAP_DANCE(td_doc_down, bindings = <&kp DOWN>, <&masked_doc_down>;
                tapping-term-ms = <220>;)

  #define NAV_LEFT &td_home
  #define NAV_RIGHT &td_end
  #define NAV_UP &td_doc_up
  #define NAV_DOWN &td_doc_down

  #define SPACE_FULL &kp LC(LG(F))

// window and fit
  #define WIN_LEFT    &kp LC(LA(LG(LEFT)))
  #define WIN_RIGHT   &kp LC(LA(LG(RIGHT)))
  #define FIT_LEFT    &kp LC(LA(LEFT))
  #define FIT_RIGHT   &kp LC(LA(RIGHT))
  #define SPACE_LEFT  &kp LC(LEFT)
  #define SPACE_RIGHT &kp LC(RIGHT)
  #define SP_LEFT     &kp LC(LEFT)
  #define SP_RIGHT    &kp LC(RIGHT)
#else
// homerow mods
  #define OL_IDX LCTRL
  #define OL_PNK LGUI
  #define OR_IDX RCTRL
  #define OR_PNK RGUI
// clipboard shortcut
  #define C_RDO LC(Y)
  #define C_PST LC(V)
  #define C_CPY LC(C)
  #define C_CUT LC(X)
  #define C_UND LC(Z)
  #define C_ALL LC(A)
// Desktop and tab navigation
  #define LANG_CHANGE LANG1
  #define SCREENSHOT LG(LS(S))
  #define LOCK  &kp LG(L)
  #define W_CLS LA(F4)
  #define T_CLS LC(F4)
  #define T_RHT LC(TAB)
  #define T_LFT LC(LS(TAB))
  #define W_RHT LA(TAB)
  #define W_LFT LA(LS(TAB))
  #define D_PRV LG(LC(LEFT))
  #define D_NXT LG(LC(RIGHT))

  // Tap: Left/Right | Double-tap: Ctrl + Left/Right = previous/next word.
  MASK_MODS(masked_left, (MOD_LCTL), &kp LC(LEFT))
  MASK_MODS(masked_right, (MOD_LCTL), &kp LC(RIGHT))

  ZMK_TAP_DANCE(td_left, bindings = <&kp LEFT>, <&masked_left>;
                tapping-term-ms = <220>;)
  ZMK_TAP_DANCE(td_right, bindings = <&kp RIGHT>, <&masked_right>;
                tapping-term-ms = <220>;)

  // Tap: Up/Down | Double-tap: Ctrl + Home/End = start/end of document.
  MASK_MODS(masked_doc_home, (MOD_LCTL), &kp LC(HOME))
  MASK_MODS(masked_doc_end, (MOD_LCTL), &kp LC(END))

  ZMK_TAP_DANCE(td_doc_home, bindings = <&kp UP>, <&masked_doc_home>;
                tapping-term-ms = <220>;)
  ZMK_TAP_DANCE(td_doc_end, bindings = <&kp DOWN>, <&masked_doc_end>;
                tapping-term-ms = <220>;)

  #define NAV_LEFT  &td_left
  #define NAV_RIGHT &td_right
  #define NAV_UP    &td_doc_home
  #define NAV_DOWN  &td_doc_end

  #define SPACE_FULL  &kp LG(UP)

  // window and fit
  #define WIN_LEFT    &kp LG(LEFT)       // Win + Left
  #define WIN_RIGHT   &kp LG(RIGHT)      // Win + Right
  #define SPACE_LEFT  &kp LC(LG(LEFT))   // Ctrl + Win + Left
  #define SPACE_RIGHT &kp LC(LG(RIGHT))  // Ctrl + Win + Right
  #define SP_LEFT     &kp LC(LG(LEFT))   // Ctrl + Win + Left
  #define SP_RIGHT    &kp LC(LG(RIGHT))  // Ctrl + Win + Right
  #define FIT_LEFT    &kp LS(LG(LEFT))   // Shift + Win + Left
  #define FIT_RIGHT   &kp LS(LG(RIGHT))  // Shift + Win + Right
#endif
// Desktop management shortcuts
#define PIN_WIN   &kp LG(LC(LS(Q)))       // Pin window across desktops.
#define PIN_APP   &kp LG(LC(LS(A)))       // Pin application across desktops.
#define DSK_MGR   &kp LA(GRAVE)           // Desktop manager.
